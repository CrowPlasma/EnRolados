// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String   @default("AGENT") // SUPER_ADMIN, ADMIN, AGENT
  defaultShift String   @default("MORNING") // MORNING, EVENING, NIGHT
  workDays     String   @default("[1,2,3,4,5]") // JSON string of days: 1=Mon, 7=Sun
  level        String   @default("N1")
  email        String?
  phone        String?
  homeOfficeDays String @default("[]") // JSON array: [1,3,5] = Mon/Wed/Fri
  showInCalendar Boolean @default(true)
  shifts       Shift[]
  absences     Absence[]
  auditLogs    AuditLog[] @relation("AuditActor")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Shift {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  type      String   // MORNING, EVENING, NIGHT, GUARD
  isManual  Boolean  @default(false)
  isHomeOffice Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, type])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Absence {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  type      String   // VACATION, SICK_LEAVE, OTHER
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String   // e.g., UPDATE_USER, MOVE_SHIFT, DELETE_USER
  details   String
  createdAt DateTime @default(now())
}
